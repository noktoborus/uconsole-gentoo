inherit cargo desktop xdg

DESCRIPTION="GUI terminal for serial consoles and the local shell"
HOMEPAGE="https://github.com/noktoborus/zyterm"
SRC_URI="
	https://github.com/noktoborus/zyterm/archive/refs/tags/v${PV}.tar.gz -> ${P}.tar.gz
	${CARGO_CRATE_URIS}
"

LICENSE="MIT"
# Dependent crate licenses
LICENSE+="
	Apache-2.0 BSD Boost-1.0 ISC MPL-2.0 OFL-1.1 UbuntuFontLicense-1.0
	Unicode-3.0 Unicode-DFS-2016 WTFPL-2 ZLIB
"
SLOT="0"
KEYWORDS="amd64 arm64"

DEPEND="media-libs/fontconfig"
RDEPEND="
	${DEPEND}
	dev-libs/wayland
	media-libs/mesa
	media-libs/vulkan-loader
	x11-libs/libxkbcommon
"
BDEPEND="virtual/pkgconfig"

QA_FLAGS_IGNORED="usr/bin/.*"

src_compile() {
	cargo_src_compile
	cargo_src_compile -p zyt-script
}

src_install() {
	cargo_src_install
	cargo_src_install --path crates/zyt-script

	local id=ru.styxheim.zyterm
	domenu assets/${id}.desktop
	insinto /usr/share/kio/servicemenus
	doins assets/${id}.open.desktop
	newicon -s scalable assets/icon.svg ${id}.svg
	newicon -s 256 assets/icon.png ${id}.png
	insinto /usr/share/zyterm/osc
	doins assets/osc/osc133-bash.sh
	insinto /usr/share/zyterm/scripts
	(cd scripts && find . -type f \( -name '*.lua' -o -name '*.sh' -o -name 'Manifest.yaml' \) \
		-exec install -Dm644 {} "${ED}"/usr/share/zyterm/scripts/{} \;) || die
	einstalldocs
}
