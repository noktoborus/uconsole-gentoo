From 09ed54769276b7de13beb63f14fc1f96962d8c30 Mon Sep 17 00:00:00 2001
From: Jacob Procee <sn125164@gmail.com>
Date: Tue, 20 Oct 2026 11:37:48 +0200
Subject: [PATCH 2/2] scene: only re-apply gamma on enable if one is set

When an output is enabled, the scene marks the gamma LUT as changed so
that it's re-applied. Without a gamma-control client that only commits a
NULL color transform, a no-op reset that the backend may not support
(see the previous commit). Only re-apply it when a client has set a LUT.

Closes: https://gitlab.freedesktop.org/wlroots/wlroots/-/issues/4123
---
 types/scene/wlr_scene.c | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/types/scene/wlr_scene.c b/types/scene/wlr_scene.c
index 870fd91a1..e9a5f85f4 100644
--- a/types/scene/wlr_scene.c
+++ b/types/scene/wlr_scene.c
@@ -1784,7 +1784,8 @@ static void scene_output_handle_commit(struct wl_listener *listener, void *data)
 	// Next time the output is enabled, try to re-apply the gamma LUT
 	if (scene_output->scene->gamma_control_manager_v1 &&
 			(state->committed & WLR_OUTPUT_STATE_ENABLED) &&
-			!scene_output->output->enabled) {
+			!scene_output->output->enabled &&
+			scene_output->gamma_lut != NULL) {
 		scene_output->gamma_lut_changed = true;
 	}
 }
