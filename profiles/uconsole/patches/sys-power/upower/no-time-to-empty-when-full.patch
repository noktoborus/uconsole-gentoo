upower gives a time to empty to a battery in any state but charging. A
full battery on AC then gets one too: the small current that still flows
into the cells is taken as a discharge, and upower shows days to empty.
This gives the time to empty only when the battery can discharge: not
when it is fully charged, and not when it is pending a charge. The time
is worked out after the guesses of the state, so it uses the state that
is shown. up_daemon_update_display_battery() does the same for more than
one battery. A test is added to src/linux/integration-test.py.

diff --git a/src/linux/integration-test.py b/src/linux/integration-test.py
index 815fd49..a3cc49a 100755
--- a/src/linux/integration-test.py
+++ b/src/linux/integration-test.py
@@ -1565,6 +1565,74 @@ class Tests(dbusmock.DBusTestCase):
         )
         self.stop_daemon()
 
+    def test_no_time_to_empty_when_full_on_ac(self):
+        """No time to empty for a full or idle battery with a rest current"""
+
+        ac = self.testbed.add_device(
+            "power_supply",
+            "AC",
+            None,
+            ["type", "Mains", "online", "1"],
+            [],
+        )
+        bat0 = self.testbed.add_device(
+            "power_supply",
+            "BAT0",
+            None,
+            [
+                "type",
+                "Battery",
+                "present",
+                "1",
+                "status",
+                "Full",
+                "energy_full",
+                "32000000",
+                "energy_full_design",
+                "32000000",
+                "energy_now",
+                "32000000",
+                "capacity",
+                "100",
+                "power_now",
+                "63000",
+                "voltage_now",
+                "4200000",
+            ],
+            [],
+        )
+
+        self.start_daemon()
+        devs = self.proxy.EnumerateDevices()
+        self.assertEqual(len(devs), 2)
+        bat0_up = [d for d in devs if "BAT" in d][0]
+        self.assertEqual(
+            self.get_dbus_dev_property(bat0_up, "State"), UP_DEVICE_STATE_FULLY_CHARGED
+        )
+        self.assertEqual(self.get_dbus_dev_property(bat0_up, "TimeToEmpty"), 0)
+        self.assertEqual(self.get_dbus_display_property("TimeToEmpty"), 0)
+        self.stop_daemon()
+
+        # "Not charging" at 95 % is shown as fully charged, with no time either
+        self.testbed.set_attribute(bat0, "status", "Not charging")
+        self.testbed.set_attribute(bat0, "capacity", "95")
+        self.testbed.set_attribute(bat0, "energy_now", "30400000")
+        self.start_daemon()
+        self.assertEqual(
+            self.get_dbus_dev_property(bat0_up, "State"), UP_DEVICE_STATE_FULLY_CHARGED
+        )
+        self.assertEqual(self.get_dbus_dev_property(bat0_up, "TimeToEmpty"), 0)
+        self.stop_daemon()
+
+        # a discharge still has its time
+        self.testbed.set_attribute(ac, "online", "0")
+        self.testbed.set_attribute(bat0, "status", "Discharging")
+        self.testbed.set_attribute(bat0, "energy_now", "30000000")
+        self.testbed.set_attribute(bat0, "power_now", "7500000")
+        self.start_daemon()
+        self.assertEqual(self.get_dbus_dev_property(bat0_up, "TimeToEmpty"), 14400)
+        self.stop_daemon()
+
