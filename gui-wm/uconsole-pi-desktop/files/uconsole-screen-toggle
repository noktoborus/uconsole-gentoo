#!/bin/sh
# /usr/bin/uconsole-screen-toggle [lock]: a short press of the power key
# in sway. A panel that is on goes off, after swaylock with "lock"; a panel
# that is off comes on (swaylock asks the password then).
set -eu

if swaymsg -t get_outputs | grep -q '"power": true'; then
    [ "${1:-}" != lock ] || swaylock -f -c 000000
    swaymsg 'output * power off'
else
    swaymsg 'output * power on'
fi
