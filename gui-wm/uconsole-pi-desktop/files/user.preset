# The sound server of each user: PipeWire with its pulse server, and
# WirePlumber. systemctl --global preset-all turns them on; the image runs
# it for the image.
enable pipewire.socket
enable pipewire-pulse.socket
enable wireplumber.service
enable swaync.service
# The keyring of each user (passwords by the Secret Service, unlocked by
# the password of the login, pam_gnome_keyring of pambase) and its agent
# of SSH.
enable gnome-keyring-daemon.socket
enable gcr-ssh-agent.socket
