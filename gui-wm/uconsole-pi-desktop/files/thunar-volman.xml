<?xml version="1.0" encoding="UTF-8"?>
<!--
  /etc/xdg/xfce4/xfconf/xfce-perchannel-xml/thunar-volman.xml: the defaults
  of thunar-volman for each user, who can change them (Thunar, Preferences,
  Advanced). Drives and media that are plugged in are mounted at once; by
  default thunar-volman mounts nothing.
-->
<channel name="thunar-volman" version="1.0">
  <property name="automount-drives" type="empty">
    <property name="enabled" type="bool" value="true"/>
  </property>
  <property name="automount-media" type="empty">
    <property name="enabled" type="bool" value="true"/>
  </property>
</channel>
