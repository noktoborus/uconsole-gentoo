diff --git a/arch/arm/boot/dts/overlays/Makefile b/arch/arm/boot/dts/overlays/Makefile
index f2b8dce6d4..1eef782d59 100644
--- a/arch/arm/boot/dts/overlays/Makefile
+++ b/arch/arm/boot/dts/overlays/Makefile
@@ -49,6 +49,10 @@ dtbo-$(CONFIG_ARCH_BCM2835) += \
 	clockworkpi-uconsole-cm4.dtbo \
 	clockworkpi-uconsole-cm4s.dtbo \
 	clockworkpi-uconsole-cm5.dtbo \
+	cardputerzero.dtbo \
+		spk-gpio24-high.dtbo \
+		spi0-spidev2-gpio22.dtbo \
+		camera-gpio16-high.dtbo \
 	cm-swap-i2c0.dtbo \
 	cma.dtbo \
 	crystalfontz-cfa050_pi_m.dtbo \
diff --git a/arch/arm/boot/dts/overlays/camera-gpio16-high-overlay.dts b/arch/arm/boot/dts/overlays/camera-gpio16-high-overlay.dts
new file mode 100644
index 0000000000..1b9b34b735
--- /dev/null
+++ b/arch/arm/boot/dts/overlays/camera-gpio16-high-overlay.dts
@@ -0,0 +1,19 @@
+/dts-v1/;
+/plugin/;
+
+/ {
+    compatible = "brcm,bcm2835";
+
+    fragment@0 {
+        target = <&gpio>;
+        __overlay__ {
+
+            cam_high_pin: cam-high {
+                gpio-hog;
+                gpios = <16 0>;
+                output-high;
+                line-name = "cam-high-pin";
+            };
+        };
+    };
+};
\ No newline at end of file
diff --git a/arch/arm/boot/dts/overlays/cardputerzero-overlay.dts b/arch/arm/boot/dts/overlays/cardputerzero-overlay.dts
new file mode 100644
index 0000000000..647d3eeb58
--- /dev/null
+++ b/arch/arm/boot/dts/overlays/cardputerzero-overlay.dts
@@ -0,0 +1,494 @@
+// Definitions for ES8389 Audio HAT
+/dts-v1/;
+/plugin/;
+// dtc -@ -I dts -O dtb -o es8389_m5stack.dtbo  es8389_m5stack.dts
+/ {
+    compatible = "brcm,bcm2835";
+    
+    fragment@0 {
+        target = <&i2s_clk_producer>;
+        __overlay__ {
+            status = "okay";
+        };
+    };
+
+    fragment@1 {
+        target = <&gpio>;
+        __overlay__ {
+            st7789v_pins: st7789v_pins {
+                    brcm,pins = <25>;
+                    brcm,function = <1>;
+                    brcm,pull = <0>;
+            };
+            tca8418_pins: tca8418_pins {
+                    brcm,pins = <27 17 16>;
+                    brcm,function = <0 1 1>;
+                    brcm,pull = <2 0 0>;
+            };
+            spk_en_pins: spk_en_pins {
+                    brcm,pins = <24>;
+                    brcm,function = <1>;
+                    brcm,pull = <0>;
+            };
+            cam_en_pins: cam_en_pins {
+                    brcm,pins = <16>;
+                    brcm,function = <1>;
+                    brcm,pull = <0>;
+            };
+            // always_high_pin: always-high {
+            //     gpio-hog;
+            //     gpios = <24 0>;
+            //     output-high;
+            //     line-name = "always-high-pin";
+            // };
+            // cam_high_pin: cam-high {
+            //     gpio-hog;
+            //     gpios = <16 0>;
+            //     output-high;
+            //     line-name = "cam-high-pin";
+            // };
+        };
+    };
+
+    fragment@2 {
+        target = <&i2c1>;
+        __overlay__ {
+            #address-cells = <1>;
+            #size-cells = <0>;
+            status = "okay";
+
+            py32io16: gpio@4f {
+                    compatible = "m5stack,py32io16";
+                    reg = <0x4f>;
+                    gpio-controller;
+                    #gpio-cells = <2>;
+                    ngpios = <16>;
+                    #pwm-cells = <3>;
+                    status = "okay";
+            };
+            es8390: es8390@10 {
+                compatible = "everest,es8390";
+                reg = <0x10>;
+                #sound-dai-cells = <0>;
+                pinctrl-names = "default";
+                pinctrl-0 = <&spk_en_pins>;
+                clock-names = "mclk";
+                clocks = <&es8390_mclk>;
+                // spk-enable-gpios = <&gpio 24 1>;
+                status = "okay";
+            };
+			hpamp: hpamp@60 {
+				compatible = "ti,tpa6130a2";
+				reg = <0x60>;
+                power-supply = <&hpamp_regulator>;
+				status = "okay";
+			};
+            rx8130: rx8130@32 {
+                compatible = "epson,rx8130";
+                reg = <0x32>;
+                status = "okay";
+            };
+
+            imu@68 {
+                compatible = "bosch,bmi270";
+                reg = <0x68>;
+                status = "okay";
+            };
+
+            tca8418@34 {
+                compatible = "m5stack,tca8418c"; 
+                reg = <0x34>;
+                pinctrl-names = "default";
+                pinctrl-0 = <&tca8418_pins>;
+                interrupt-parent = <&gpio>;
+                interrupts = <27 2>; /* 中断io 下沿触发  */
+                irq-gpios = <&gpio 27 0x00>; /* 中断io 下沿触发 */
+                    
+                keypad,num-rows = <5>;
+                keypad,num-columns = <10>;
+
+                // tables-sel-gpio = <&gpio 17 1>;
+                // capslock-gpio = <&gpio 16 1>;
+                tables-sel-gpio = <&py32io16 8 1>;
+                capslock-gpio = <&py32io16 7 1>;
+
+                sym-button-code = <0x43>; 
+                fn-button-code = <0x42>;  
+                asmux-button-code = <0x41>; 
+
+
+                // switch-button-code = <73>; /* 切换按键 keycode */
+                // interrupt-controller;
+                /* row | column | key-code  例如: 04,08,0010 q 键 */
+                /* row | column | key-code  例如: 04,08,0010 => Q 键 */
+                linux,keymap = <
+0x04000001 /* row=0x04 col=0x00 keycode=0x0001  KEY_ESC        Esc */
+0x0409000f /* row=0x04 col=0x09 keycode=0x000f  KEY_TAB        Tab */
+
+0x04040002 /* row=0x04 col=0x04 keycode=0x0002  KEY_1          1 */
+0x00000003 /* row=0x00 col=0x00 keycode=0x0003  KEY_2          2 */
+0x00010004 /* row=0x00 col=0x01 keycode=0x0004  KEY_3          3 */
+0x00020005 /* row=0x00 col=0x02 keycode=0x0005  KEY_4          4 */
+0x00030006 /* row=0x00 col=0x03 keycode=0x0006  KEY_5          5 */
+0x00040007 /* row=0x00 col=0x04 keycode=0x0007  KEY_6          6 */
+0x00050008 /* row=0x00 col=0x05 keycode=0x0008  KEY_7          7 */
