+/* ============================================================================
+ * Pinctrl 功能实现
+ * ============================================================================ */
+
+static const struct pinctrl_pin_desc py32io_pins[] = {
+    PINCTRL_PIN(0, "IO1"),
+    PINCTRL_PIN(1, "IO2"),
+    PINCTRL_PIN(2, "IO3"),
+    PINCTRL_PIN(3, "IO4"),
+    PINCTRL_PIN(4, "IO5"),
+    PINCTRL_PIN(5, "IO6"),
+    PINCTRL_PIN(6, "IO7"),
+    PINCTRL_PIN(7, "IO8"),
+    PINCTRL_PIN(8, "IO9"),
