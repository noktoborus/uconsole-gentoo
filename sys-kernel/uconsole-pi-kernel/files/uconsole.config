# Merged over the defconfig by config.sh, for both modules; then
# uconsole-<platform>.config. The drivers of the uConsole are already in
# the defconfigs of the patch series (patch 0001). config.sh stops if a
# line here is not in the final .config. CONFIG_LOCALVERSION is in the
# file of the platform: the kernels of the platforms are installed side by
# side, each with /lib/modules/<release> of its own.
# CONFIG_LOCALVERSION_AUTO is not set

# NAT of IPv4 for iptables (masquerade of a shared connection).
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_IP_NF_IPTABLES_LEGACY=m
CONFIG_IP_NF_NAT=m
CONFIG_IP_NF_TARGET_MASQUERADE=m

# CONFIG_CFG80211_CRDA_SUPPORT is not set

# The AXP228 built into the kernel, as in the 6.12 kernel of Rex; it
# powers the board off (patch 0007). bcm2712_defconfig has them =m.
CONFIG_MFD_AXP20X=y
CONFIG_MFD_AXP20X_I2C=y

# The amplifier of the speakers of the sound card uConsole (patch 0009).
CONFIG_SND_SOC_SIMPLE_AMPLIFIER=m

# The NT sync objects of Wine 10 and up, /dev/ntsync: Wine and FEX
# (notes/wine-fex.md). The device has no alias: the module is loaded
# at boot, by files/modules-load-ntsync.conf.
CONFIG_NTSYNC=m

# schedutil takes the load from the scheduler; the defconfig has
# ondemand (notes/cpufreq-cm5.md).
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
# CONFIG_CPU_FREQ_DEFAULT_GOV_ONDEMAND is not set

# Huge pages only where a program asks for them (madvise): JITs, FEX.
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y

# Landlock, the sandbox of a program with no root. The defconfigs set
# CONFIG_LSM="", so no LSM was on at boot; AppArmor stays off.
CONFIG_SECURITY_LANDLOCK=y
CONFIG_LSM="landlock"

# Misc
CONFIG_INPUT_PWM_VIBRA=m
CONFIG_INPUT_GPIO_VIBRA=m
