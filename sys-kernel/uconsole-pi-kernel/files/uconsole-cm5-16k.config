# Merged by config.sh over bcm2712_defconfig and uconsole.config, for the
# CM5 with USE cm5-16k, in place of uconsole-cm5.config: the 16K pages of
# bcm2712_defconfig. The packages of the builder are made under qemu with
# 4K pages; with 16K, dev-libs/jemalloc must be built with
# --with-lg-page=16, and 32-bit programs and some JITs do not run
# (notes/gentoo-image.md, decision 6).
CONFIG_LOCALVERSION="-uconsole-cm5-16k"
CONFIG_ARM64_16K_PAGES=y
# CONFIG_ARM64_4K_PAGES is not set
