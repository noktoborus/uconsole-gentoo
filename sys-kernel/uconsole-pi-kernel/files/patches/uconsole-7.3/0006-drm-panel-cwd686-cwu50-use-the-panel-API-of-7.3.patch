From b5e560c9c8daf4dcd504e0808783fb4fcac627d0 Mon Sep 17 00:00:00 2001
From: Noktoborus <noktoborus@gmail.com>
Date: Sat, 24 Oct 2026 20:21:50 +0000
Subject: [PATCH] drm/panel: cwd686, cwu50: use the panel API of 7.3

drm_panel_init() is gone: the panel is allocated and set up by
devm_drm_panel_alloc(). of_drm_get_panel_orientation() is now
drm_of_get_panel_orientation() of <drm/drm_of.h>.
---
 drivers/gpu/drm/panel/panel-cwd686.c | 12 ++++++------
 drivers/gpu/drm/panel/panel-cwu50.c  | 12 ++++++------
 2 files changed, 12 insertions(+), 12 deletions(-)

diff --git a/drivers/gpu/drm/panel/panel-cwd686.c b/drivers/gpu/drm/panel/panel-cwd686.c
index e2715ac4d..8abd0a0f5 100644
--- a/drivers/gpu/drm/panel/panel-cwd686.c
+++ b/drivers/gpu/drm/panel/panel-cwd686.c
@@ -2,6 +2,7 @@
 
 #include <drm/drm_modes.h>
 #include <drm/drm_mipi_dsi.h>
+#include <drm/drm_of.h>
 #include <drm/drm_panel.h>
 #include <linux/backlight.h>
 #include <linux/gpio/consumer.h>
@@ -223,9 +224,10 @@ static int cwd686_probe(struct mipi_dsi_device *dsi)
 	struct cwd686 *ctx;
 	int ret;
 
-	ctx = devm_kzalloc(dev, sizeof(*ctx), GFP_KERNEL);
-	if (!ctx)
-		return -ENOMEM;
+	ctx = devm_drm_panel_alloc(dev, struct cwd686, panel, &cwd686_drm_funcs,
+				   DRM_MODE_CONNECTOR_DSI);
+	if (IS_ERR(ctx))
+		return PTR_ERR(ctx);
 
 	mipi_dsi_set_drvdata(dsi, ctx);
 	ctx->dev = dev;
@@ -248,7 +250,7 @@ static int cwd686_probe(struct mipi_dsi_device *dsi)
 		return PTR_ERR(ctx->backlight);
 	}
 
-	ret = of_drm_get_panel_orientation(dev->of_node, &ctx->orientation);
+	ret = drm_of_get_panel_orientation(dev->of_node, &ctx->orientation);
 	if (ret) {
 		dev_err(dev, "%pOF: failed to get orientation %d\n", dev->of_node, ret);
 		return ret;
@@ -256,8 +258,6 @@ static int cwd686_probe(struct mipi_dsi_device *dsi)
 
 	ctx->panel.prepare_prev_first = true;
 
-	drm_panel_init(&ctx->panel, dev, &cwd686_drm_funcs, DRM_MODE_CONNECTOR_DSI);
-
 	drm_panel_add(&ctx->panel);
 
 	ret = mipi_dsi_attach(dsi);
diff --git a/drivers/gpu/drm/panel/panel-cwu50.c b/drivers/gpu/drm/panel/panel-cwu50.c
index 925bbb17c..f6f614f5e 100644
--- a/drivers/gpu/drm/panel/panel-cwu50.c
+++ b/drivers/gpu/drm/panel/panel-cwu50.c
@@ -10,6 +10,7 @@
 
 #include <drm/drm_modes.h>
 #include <drm/drm_mipi_dsi.h>
+#include <drm/drm_of.h>
 #include <drm/drm_panel.h>
 #include <linux/backlight.h>
 #include <linux/gpio/consumer.h>
@@ -897,9 +898,10 @@ static int cwu50_probe(struct mipi_dsi_device *dsi)
 	const struct of_device_id *match;
 	int ret, err;
 
-	ctx = devm_kzalloc(dev, sizeof(*ctx), GFP_KERNEL);
-	if (!ctx)
-		return -ENOMEM;
+	ctx = devm_drm_panel_alloc(dev, struct cwu50, panel, &cwu50_drm_funcs,
+				   DRM_MODE_CONNECTOR_DSI);
+	if (IS_ERR(ctx))
+		return PTR_ERR(ctx);
 
 	mipi_dsi_set_drvdata(dsi, ctx);
 	ctx->dev = dev;
@@ -987,7 +989,7 @@ static int cwu50_probe(struct mipi_dsi_device *dsi)
 		ctx->iovcc = NULL;
 	}
 
-	ret = of_drm_get_panel_orientation(dev->of_node, &ctx->orientation);
+	ret = drm_of_get_panel_orientation(dev->of_node, &ctx->orientation);
 	if (ret) {
 		dev_err(dev, "%pOF: failed to get orientation %d\n", dev->of_node, ret);
 		return ret;
@@ -995,8 +997,6 @@ static int cwu50_probe(struct mipi_dsi_device *dsi)
 
 	ctx->panel.prepare_prev_first = true;
 
-	drm_panel_init(&ctx->panel, dev, &cwu50_drm_funcs, DRM_MODE_CONNECTOR_DSI);
-
 	if (ctx->is_reset_only) {
 		/*
 		 * Let the DRM core drive the backlight, matching the
-- 
2.39.5

