+
+	axp20x_pek_read_press(axp20x_pek, &pdev->dev, "pek-short-press",
+			      AXP20X_PEK_SHORT);
+	axp20x_pek_read_press(axp20x_pek, &pdev->dev, "pek-long-press",
+			      AXP20X_PEK_LONG);
+
+	axp20x_pek->input = devm_input_allocate_device(&pdev->dev);
+	if (!axp20x_pek->input)
+		return -ENOMEM;
+
+	idev = axp20x_pek->input;
+
+	idev->name = "axp20x-pek";
+	idev->phys = "m1kbd/input2";
+	idev->dev.parent = &pdev->dev;
+
+	input_set_drvdata(idev, axp20x_pek);
+
+	/*
+	 * A short or a long press set in the device tree: the key sends
+	 * their events only, not KEY_POWER on each edge.
+	 */
+	for (kind = 0; kind < AXP20X_PEK_KINDS; kind++) {
+		if (!axp20x_pek->press[kind].enabled)
+			continue;
+		by_press = true;
+		error = axp20x_pek_request_press(axp20x_pek, pdev, kind);
+		if (error)
