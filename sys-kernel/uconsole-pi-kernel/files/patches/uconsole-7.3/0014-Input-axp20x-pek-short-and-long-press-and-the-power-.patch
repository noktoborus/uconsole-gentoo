+/* REG 36H bits 5-4 of the AXP221 and AXP228. */
+static const struct axp20x_time axp221_long_time[] = {
+	{ .time = 1000, .idx = 0 },
+	{ .time = 1500, .idx = 1 },
+	{ .time = 2000, .idx = 2 },
