 	if (axp20x_pek_should_register_input(axp20x_pek)) {
 		error = axp20x_pek_probe_input_device(axp20x_pek, pdev);
@@ -320,8 +533,6 @@ static int axp20x_pek_probe(struct platform_device *pdev)
 			return error;
