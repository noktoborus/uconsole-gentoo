+/* The index of the time of a table nearest to @val. */
+static unsigned int axp20x_pek_nearest(const struct axp20x_time *time,
+				       unsigned int val)
+{
+	unsigned int best_err = UINT_MAX;
+	unsigned int idx = 0;
+	int i;
+
+	for (i = 3; i >= 0; i--) {
+		unsigned int err = abs(time[i].time - val);
+
+		if (err < best_err) {
+			best_err = err;
+			idx = time[i].idx;
+		}
+
+		if (!err)
+			break;
+	}
+
+	return idx;
+}
