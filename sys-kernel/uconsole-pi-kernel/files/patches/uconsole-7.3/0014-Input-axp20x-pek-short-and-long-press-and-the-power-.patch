+	axp20x_pek->irqs[axp20x_pek->nr_irqs++] = axp20x_pek->irq_dbf;
+	axp20x_pek->irqs[axp20x_pek->nr_irqs++] = axp20x_pek->irq_dbr;
+
+	return 0;
