 				 mask, idx);
 	if (ret != 0)
@@ -214,11 +263,135 @@ static irqreturn_t axp20x_pek_irq(int irq, void *pwr)
 	return IRQ_HANDLED;
 }
 
-static int axp20x_pek_probe_input_device(struct axp20x_pek *axp20x_pek,
-					 struct platform_device *pdev)
+/* A short or a long press: a key goes down and up, a switch turns over. */
+static irqreturn_t axp20x_pek_press_irq(int irq, void *data)
+{
+	struct axp20x_pek_press *press = data;
+	struct input_dev *idev = press->pek->input;
+
+	if (press->type == EV_SW) {
+		press->state = !press->state;
+		input_report_switch(idev, press->code, press->state);
+	} else {
+		input_report_key(idev, press->code, 1);
+		input_sync(idev);
+		input_report_key(idev, press->code, 0);
+	}
+	input_sync(idev);
+
+	return IRQ_HANDLED;
+}
+
+/*
+ * Reads the node @name of the PMIC: the event of a press, and for the long
+ * press its time. A node that is wrong is left out with a warning.
+ */
+static void axp20x_pek_read_press(struct axp20x_pek *axp20x_pek,
+				  struct device *dev, const char *name,
+				  enum axp20x_pek_kind kind)
+{
+	struct axp20x_pek_press *press = &axp20x_pek->press[kind];
+	struct fwnode_handle *child;
+	u32 type = EV_KEY, code, ms;
+
+	child = device_get_named_child_node(dev->parent, name);
+	if (!child)
+		return;
+
+	if (!axp20x_pek->info->dt_settings) {
+		dev_warn(dev, "%s: not supported on this PMIC, left out\n", name);
+		goto out;
+	}
+
+	fwnode_property_read_u32(child, "linux,input-type", &type);
+	if (fwnode_property_read_u32(child, "linux,code", &code)) {
+		dev_warn(dev, "%s: no linux,code, left out\n", name);
+		goto out;
+	}
+	if (!(type == EV_KEY && code <= KEY_MAX) &&
+	    !(type == EV_SW && code <= SW_MAX)) {
+		dev_warn(dev, "%s: event %u:%u is not a key or a switch, left out\n",
+			 name, type, code);
+		goto out;
+	}
+
+	if (kind == AXP20X_PEK_LONG &&
+	    !fwnode_property_read_u32(child, "x-powers,time-ms", &ms))
+		regmap_update_bits(axp20x_pek->axp20x->regmap, AXP20X_PEK_KEY,
+				   AXP20X_PEK_LONG_MASK,
+				   axp20x_pek_nearest(axp20x_pek->info->long_time,
+						      ms) << 4);
+
+	press->pek = axp20x_pek;
+	press->type = type;
+	press->code = code;
+	press->enabled = true;
+out:
+	fwnode_handle_put(child);
+}
+
+/*
+ * x-powers,pek-power-off-ms of the PMIC: the time of the hardware power
+ * off, or 0 to turn it off (REG 36H bits 3 and 1-0).
+ */
+static void axp20x_pek_read_power_off(struct axp20x_pek *axp20x_pek,
+				      struct device *dev)
+{
+	const struct axp20x_info *info = axp20x_pek->info;
+	unsigned int val;
+	u32 ms;
+
+	if (device_property_read_u32(dev->parent, "x-powers,pek-power-off-ms",
+				     &ms))
+		return;
+
+	if (!info->dt_settings) {
+		dev_warn(dev, "x-powers,pek-power-off-ms: not supported on this PMIC\n");
+		return;
+	}
+
+	val = ms ? AXP20X_PEK_SHUTDOWN_EN |
+		   axp20x_pek_nearest(info->shutdown_time, ms) : 0;
+	regmap_update_bits(axp20x_pek->axp20x->regmap, AXP20X_PEK_KEY,
+			   AXP20X_PEK_SHUTDOWN_EN | info->shutdown_mask, val);
+}
+
+/* Takes the interrupt of a press the device tree set. */
+static int axp20x_pek_request_press(struct axp20x_pek *axp20x_pek,
+				    struct platform_device *pdev,
+				    enum axp20x_pek_kind kind)
+{
+	static const char * const names[] = { "PEK_SHORT", "PEK_LONG" };
+	struct axp20x_pek_press *press = &axp20x_pek->press[kind];
+	int irq, error;
+
+	irq = platform_get_irq_byname(pdev, names[kind]);
+	if (irq < 0)
+		return irq;
+	press->irq = regmap_irq_get_virq(axp20x_pek->axp20x->regmap_irqc, irq);
+
+	input_set_capability(axp20x_pek->input, press->type, press->code);
+
+	error = devm_request_any_context_irq(&pdev->dev, press->irq,
+					     axp20x_pek_press_irq, 0,
+					     names[kind], press);
+	if (error < 0) {
+		dev_err(&pdev->dev, "Failed to request %s IRQ#%d: %d\n",
+			names[kind], press->irq, error);
+		return error;
+	}
+
+	axp20x_pek->irqs[axp20x_pek->nr_irqs++] = press->irq;
+
+	return 0;
+}
+
+/* The key sends KEY_POWER on its edges: down, then up. */
+static int axp20x_pek_request_edges(struct axp20x_pek *axp20x_pek,
+				    struct platform_device *pdev)
 {
 	struct axp20x_dev *axp20x = axp20x_pek->axp20x;
-	struct input_dev *idev;
