From 1b2799d7e60cda14c242715001fd903fcc446221 Mon Sep 17 00:00:00 2001
From: Noktoborus <noktoborus@gmail.com>
Date: Sun, 1 Nov 2026 09:38:53 +0000
Subject: [PATCH] mfd: axp20x: print the result of the power-off write (test)

Test of the power-off of the uConsole on 7.3: the AXP228 stays on after
poweroff. axp20x_power_off prints the result of regmap_set_bits on the
console and waits 10 s, so that the lines are seen before the power goes,
and says when the board still runs after them. Not for the image.
---
 drivers/mfd/axp20x.c | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/drivers/mfd/axp20x.c b/drivers/mfd/axp20x.c
index 50df66de24e..84a53f89cdd 100644
--- a/drivers/mfd/axp20x.c
+++ b/drivers/mfd/axp20x.c
@@ -1253,10 +1253,13 @@ static int axp20x_power_off(struct sys_off_data *data)
 		break;
 	}
 
-	regmap_set_bits(axp20x->regmap, shutdown_reg, AXP20X_OFF);
+	pr_emerg("axp20x: power off: set bit 7 of 0x%x\n", shutdown_reg);
+	pr_emerg("axp20x: power off: regmap_set_bits = %d\n",
+		 regmap_set_bits(axp20x->regmap, shutdown_reg, AXP20X_OFF));
 
 	/* Give capacitors etc. time to drain to avoid kernel panic msg. */
-	mdelay(500);
+	mdelay(10000);
+	pr_emerg("axp20x: power off: still running after 10 s\n");
 
 	return NOTIFY_DONE;
 }
